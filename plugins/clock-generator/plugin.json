{
  "format": "kizamubeam-pack",
  "formatVersion": 2,
  "id": "org.kizamubeam.clock-generator",
  "version": "1.0.0",
  "name": {
    "en": "Analog clock generator",
    "de": "Uhren-Generator (Analog)",
    "it": "Generatore di orologi analogici"
  },
  "description": {
    "en": "Parametric analog clocks in 10 shapes with optional backplate, stackable spacer rings, engraved or cut-out numerals with automatic stencil bridges, 6 selectable fonts, customisable tick marks and 8 hand styles.",
    "de": "Parametrische analoge Uhren in 10 Formen mit optionaler Grundplatte, stapelbaren Abstandsringen, gravierten oder ausgeschnittenen Ziffern mit automatischen Stegen, 6 wählbaren Schriftarten, einstellbaren Markierungen und 8 Zeigerformen.",
    "it": "Orologi analogici parametrici in 10 forme con piastra di fondo opzionale, anelli distanziatori impilabili, cifre incise o ritagliate con ponticelli automatici, 6 caratteri, tacche configurabili e 8 stili di lancette."
  },
  "author": "KizamuBeam",
  "homepage": "https://github.com/KizamuBeam/kizamubeam-plugins/tree/main/plugins/clock-generator",
  "build": [
    {
      "esbuild": "src/index.ts",
      "out": "dist/clock-generator.js"
    }
  ],
  "plugins": [
    {
      "id": "org.kizamubeam.clock-generator",
      "type": "generator",
      "api": 1,
      "version": 1,
      "kind": "assembly",
      "runtime": "js",
      "code": "@dist/clock-generator.js",
      "icon": "pulley",
      "host": [
        "boolean",
        "nest"
      ],
      "preview": {
        "center": true
      },
      "dialog": {
        "version": 5,
        "steps": [
          {
            "id": "body",
            "label": "step.body",
            "items": [
              "shape",
              "diameter",
              "width",
              "height",
              "cornerRadius",
              "thickness",
              "shaftDia"
            ]
          },
          {
            "id": "layers",
            "label": "step.layers",
            "items": [
              "backplate",
              "backplateCenter",
              "movementSize",
              "hangerHole",
              "ringCount",
              "ringWidth",
              "glueMarks"
            ]
          },
          {
            "id": "dial",
            "label": "step.dial",
            "items": [
              "dialStyle",
              "numeralMode",
              "font",
              "numeralSize",
              "numeralRadiusPct",
              "rotateNumerals",
              "bridgeWidth",
              "bridgeCount",
              "bridgeDirection",
              "skeletonSpokes",
              "skeletonHubDia"
            ]
          },
          {
            "id": "ticks",
            "label": "step.ticks",
            "items": [
              "tickMode",
              "tickStyle",
              "tickInset",
              "hourTickLength",
              "hourTickWidth",
              "minuteTickLength",
              "minuteTickWidth",
              "quarterAccent",
              "chapterRing"
            ]
          },
          {
            "id": "hands",
            "label": "step.hands",
            "items": [
              "includeHands",
              "handStyle",
              "includeSecondHand",
              "handWidth",
              "hourHandPct",
              "minuteHandPct",
              "hourHoleDia",
              "minuteHoleDia",
              "secondHoleDia"
            ]
          }
        ]
      },
      "params": [
        {
          "key": "shape",
          "type": "enum",
          "options": [
            ["circle", "shape.circle"],
            ["square", "shape.square"],
            ["rectangle", "shape.rectangle"],
            ["oval", "shape.oval"],
            ["octagon", "shape.octagon"],
            ["hexagon", "shape.hexagon"],
            ["dodecagon", "shape.dodecagon"],
            ["arch", "shape.arch"],
            ["squircle", "shape.squircle"],
            ["scalloped", "shape.scalloped"]
          ],
          "def": "circle"
        },
        {
          "key": "diameter",
          "type": "length",
          "min": 60,
          "max": 1000,
          "def": 240,
          "showIf": {
            "in": ["shape", ["circle", "square", "octagon", "hexagon", "dodecagon", "squircle", "scalloped"]]
          }
        },
        {
          "key": "width",
          "type": "length",
          "min": 60,
          "max": 1000,
          "def": 220,
          "showIf": {
            "in": ["shape", ["rectangle", "oval", "arch"]]
          }
        },
        {
          "key": "height",
          "type": "length",
          "min": 60,
          "max": 1000,
          "def": 280,
          "showIf": {
            "in": ["shape", ["rectangle", "oval", "arch"]]
          }
        },
        {
          "key": "cornerRadius",
          "type": "length",
          "min": 0,
          "max": 200,
          "def": 12,
          "showIf": {
            "in": ["shape", ["square", "rectangle"]]
          }
        },
        {
          "key": "thickness",
          "type": "length",
          "min": 0.5,
          "max": 20,
          "def": 3
        },
        {
          "key": "shaftDia",
          "type": "length",
          "min": 2,
          "max": 30,
          "def": 8
        },
        {
          "key": "backplate",
          "type": "bool",
          "def": true
        },
        {
          "key": "backplateCenter",
          "type": "enum",
          "options": [
            ["none", "backplateCenter.none"],
            ["shaft", "backplateCenter.shaft"],
            ["movement", "backplateCenter.movement"]
          ],
          "def": "movement",
          "showIf": { "eq": ["backplate", true] }
        },
        {
          "key": "movementSize",
          "type": "length",
          "min": 20,
          "max": 120,
          "def": 56,
          "showIf": {
            "and": [
              { "eq": ["backplate", true] },
              { "eq": ["backplateCenter", "movement"] }
            ]
          }
        },
        {
          "key": "hangerHole",
          "type": "bool",
          "def": true,
          "showIf": { "eq": ["backplate", true] }
        },
        {
          "key": "ringCount",
          "type": "int",
          "min": 0,
          "max": 10,
          "def": 1
        },
        {
          "key": "ringWidth",
          "type": "length",
          "min": 4,
          "max": 100,
          "def": 18,
          "showIf": { "gt": ["ringCount", 0] }
        },
        {
          "key": "glueMarks",
          "type": "bool",
          "def": false,
          "showIf": {
            "or": [
              { "eq": ["backplate", true] },
              { "gt": ["ringCount", 0] }
            ]
          }
        },
        {
          "key": "dialStyle",
          "type": "enum",
          "options": [
            ["classic", "dialStyle.classic"],
            ["quarters", "dialStyle.quarters"],
            ["roman", "dialStyle.roman"],
            ["romanQuarters", "dialStyle.romanQuarters"],
            ["minimal", "dialStyle.minimal"],
            ["station", "dialStyle.station"],
            ["skeleton", "dialStyle.skeleton"]
          ],
          "def": "classic"
        },
        {
          "key": "numeralMode",
          "type": "enum",
          "options": [
            ["engrave", "numeralMode.engrave"],
            ["engraveStroke", "numeralMode.engraveStroke"],
            ["cutout", "numeralMode.cutout"]
          ],
          "def": "engrave",
          "showIf": {
            "in": ["dialStyle", ["classic", "quarters", "roman", "romanQuarters", "skeleton"]]
          }
        },
        {
          "key": "font",
          "type": "enum",
          "options": [
            ["sans", "font.sans"],
            ["serif", "font.serif"],
            ["rounded", "font.rounded"],
            ["artdeco", "font.artdeco"],
            ["slab", "font.slab"],
            ["technical", "font.technical"]
          ],
          "def": "sans",
          "showIf": {
            "and": [
              { "in": ["dialStyle", ["classic", "quarters", "roman", "romanQuarters", "skeleton"]] },
              { "ne": ["numeralMode", "engraveStroke"] }
            ]
          }
        },
        {
          "key": "numeralSize",
          "type": "length",
          "min": 6,
          "max": 120,
          "def": 22,
          "showIf": {
            "in": ["dialStyle", ["classic", "quarters", "roman", "romanQuarters", "skeleton"]]
          }
        },
        {
          "key": "numeralRadiusPct",
          "type": "number",
          "min": 35,
          "max": 90,
          "def": 70,
          "showIf": {
            "in": ["dialStyle", ["classic", "quarters", "roman", "romanQuarters", "skeleton"]]
          }
        },
        {
          "key": "rotateNumerals",
          "type": "bool",
          "def": false,
          "showIf": {
            "in": ["dialStyle", ["classic", "quarters", "roman", "romanQuarters", "skeleton"]]
          }
        },
        {
          "key": "bridgeWidth",
          "type": "length",
          "min": 0.6,
          "max": 8,
          "def": 2,
          "showIf": {
            "and": [
              { "in": ["dialStyle", ["classic", "quarters", "roman", "romanQuarters", "skeleton"]] },
              { "eq": ["numeralMode", "cutout"] }
            ]
          }
        },
        {
          "key": "bridgeCount",
          "type": "enum",
          "options": [
            ["auto", "bridgeCount.auto"],
            ["1", "bridgeCount.1"],
            ["2", "bridgeCount.2"]
          ],
          "def": "auto",
          "showIf": {
            "and": [
              { "in": ["dialStyle", ["classic", "quarters", "roman", "romanQuarters", "skeleton"]] },
              { "eq": ["numeralMode", "cutout"] }
            ]
          }
        },
        {
          "key": "bridgeDirection",
          "type": "enum",
          "options": [
            ["shortest", "bridgeDirection.shortest"],
            ["vertical", "bridgeDirection.vertical"],
            ["horizontal", "bridgeDirection.horizontal"]
          ],
          "def": "shortest",
          "showIf": {
            "and": [
              { "in": ["dialStyle", ["classic", "quarters", "roman", "romanQuarters", "skeleton"]] },
              { "eq": ["numeralMode", "cutout"] }
            ]
          }
        },
        {
          "key": "skeletonSpokes",
          "type": "int",
          "min": 3,
          "max": 12,
          "def": 6,
          "showIf": { "eq": ["dialStyle", "skeleton"] }
        },
        {
          "key": "skeletonHubDia",
          "type": "length",
          "min": 16,
          "max": 150,
          "def": 36,
          "showIf": { "eq": ["dialStyle", "skeleton"] }
        },
        {
          "key": "tickMode",
          "type": "enum",
          "options": [
            ["hoursAndMinutes", "tickMode.hoursAndMinutes"],
            ["hours", "tickMode.hours"],
            ["quarters", "tickMode.quarters"],
            ["minutesOnly", "tickMode.minutesOnly"],
            ["none", "tickMode.none"]
          ],
          "def": "hoursAndMinutes"
        },
        {
          "key": "tickStyle",
          "type": "enum",
          "options": [
            ["line", "tickStyle.line"],
            ["bar", "tickStyle.bar"],
            ["taper", "tickStyle.taper"],
            ["dot", "tickStyle.dot"],
            ["cutout", "tickStyle.cutout"]
          ],
          "def": "bar",
          "showIf": { "ne": ["tickMode", "none"] }
        },
        {
          "key": "tickInset",
          "type": "length",
          "min": 2,
          "max": 80,
          "def": 8,
          "showIf": { "ne": ["tickMode", "none"] }
        },
        {
          "key": "hourTickLength",
          "type": "length",
          "min": 2,
          "max": 60,
          "def": 10,
          "showIf": { "ne": ["tickMode", "none"] }
        },
        {
          "key": "hourTickWidth",
          "type": "length",
          "min": 0.5,
          "max": 20,
          "def": 2.5,
          "showIf": {
            "and": [
              { "ne": ["tickMode", "none"] },
              { "ne": ["tickStyle", "line"] }
            ]
          }
        },
        {
          "key": "minuteTickLength",
          "type": "length",
          "min": 1,
          "max": 40,
          "def": 5,
          "showIf": { "in": ["tickMode", ["hoursAndMinutes", "minutesOnly"]] }
        },
        {
          "key": "minuteTickWidth",
          "type": "length",
          "min": 0.4,
          "max": 12,
          "def": 1.2,
          "showIf": {
            "and": [
              { "in": ["tickMode", ["hoursAndMinutes", "minutesOnly"]] },
              { "ne": ["tickStyle", "line"] }
            ]
          }
        },
        {
          "key": "quarterAccent",
          "type": "bool",
          "def": true,
          "showIf": { "in": ["tickMode", ["hoursAndMinutes", "hours"]] }
        },
        {
          "key": "chapterRing",
          "type": "enum",
          "options": [
            ["none", "chapterRing.none"],
            ["outer", "chapterRing.outer"],
            ["inner", "chapterRing.inner"],
            ["double", "chapterRing.double"]
          ],
          "def": "outer"
        },
        {
          "key": "includeHands",
          "type": "bool",
          "def": true
        },
        {
          "key": "handStyle",
          "type": "enum",
          "options": [
            ["baton", "handStyle.baton"],
            ["dauphine", "handStyle.dauphine"],
            ["spade", "handStyle.spade"],
            ["breguet", "handStyle.breguet"],
            ["railway", "handStyle.railway"],
            ["arrow", "handStyle.arrow"],
            ["leaf", "handStyle.leaf"],
            ["cathedral", "handStyle.cathedral"]
          ],
          "def": "dauphine",
          "showIf": { "eq": ["includeHands", true] }
        },
        {
          "key": "includeSecondHand",
          "type": "bool",
          "def": false,
          "showIf": { "eq": ["includeHands", true] }
        },
        {
          "key": "handWidth",
          "type": "length",
          "min": 3,
          "max": 25,
          "def": 8,
          "showIf": { "eq": ["includeHands", true] }
        },
        {
          "key": "hourHandPct",
          "type": "number",
          "min": 30,
          "max": 85,
          "def": 54,
          "showIf": { "eq": ["includeHands", true] }
        },
        {
          "key": "minuteHandPct",
          "type": "number",
          "min": 45,
          "max": 95,
          "def": 78,
          "showIf": { "eq": ["includeHands", true] }
        },
        {
          "key": "hourHoleDia",
          "type": "length",
          "min": 1,
          "max": 15,
          "def": 5.5,
          "advanced": true,
          "showIf": { "eq": ["includeHands", true] }
        },
        {
          "key": "minuteHoleDia",
          "type": "length",
          "min": 1,
          "max": 15,
          "def": 3.6,
          "advanced": true,
          "showIf": { "eq": ["includeHands", true] }
        },
        {
          "key": "secondHoleDia",
          "type": "length",
          "min": 0.4,
          "max": 6,
          "def": 1,
          "advanced": true,
          "showIf": {
            "and": [
              { "eq": ["includeHands", true] },
              { "eq": ["includeSecondHand", true] }
            ]
          }
        }
      ],
      "texts": {
        "en": {
          "name": "Analog clock",
